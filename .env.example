# Neon Postgres (use the pooled connection string)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/mersam?sslmode=require"
# Direct (non-pooled) connection, used for migrations
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/mersam?sslmode=require"

# 32+ char secret used to sign session tokens
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"
SESSION_TTL_HOURS=12

# Seeded owner account
ADMIN_EMAIL="test@mail.com"
ADMIN_PASSWORD="Test!123"
ADMIN_NAME="Administrator"

# Public site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Media storage: "local" writes to ./storage, "s3" targets any S3-compatible bucket
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Leave STORAGE_DRIVER unset (or "local") to keep uploads in Postgres. That
# needs no second service and is the right choice until the media library is
# large. Set it to "s3" only with a bucket that exists: the app checks at
# startup and falls back to Postgres if it cannot reach one, so a stale
# setting degrades rather than breaking uploads.

# Outbound email. Two providers, both over HTTPS, so neither needs SMTP,
# which a serverless host will not let out anyway. Leave both blank and the
# application runs with sending switched off, reporting that rather than
# failing.
#
# "auto" takes whichever is configured, preferring Resend.
EMAIL_PROVIDER="auto"   # auto | resend | gmail

# Resend. Mail arrives from your own domain, which has to be verified first.
RESEND_API_KEY=""
EMAIL_FROM="hello@yourdomain.com"
EMAIL_FROM_NAME="MerSam"
EMAIL_REPLY_TO=""

# Gmail. Nothing to verify and nothing to pay for, but everything arrives
# from this mailbox and Google applies its own daily limit.
#
# These are OAuth credentials, NOT an API key: Gmail will not send on the
# strength of an AIza... key, which Google documents as being for public data
# only.
#
#   1. Google Cloud console: enable the Gmail API, configure the OAuth
#      consent screen, then create an OAuth client of type "Web application".
#   2. Add http://localhost:5410/callback to its authorised redirect URIs.
#      Consent happens on your own machine, so a production URL cannot
#      receive the code.
#   3. Drop the client secret JSON into files/ (gitignored) or set the id and
#      secret below, then run `npm run gmail:authorise`.
#
# All five values are needed in Vercel: files/ is not deployed.
#
# The refresh token sends mail as that account until it is revoked at
# https://myaccount.google.com/permissions. Treat it like a password.
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_SENDER=""
