# Dependencies
node_modules
.pnp
.pnp.js

# Build output
.next
out
build
dist
next-env.d.ts
*.tsbuildinfo

# Secrets. Never commit any of these: .env holds live database and storage
# credentials. .env.example is the template and is committed deliberately.
.env
.env.*
!.env.example

# Test and QA output
/test-results
/playwright-report
/playwright/.cache
/.playwright
/coverage

# Locally stored uploads when STORAGE_DRIVER=local
/storage

# Scratch output: rendered email previews, one-off scripts
/.local

# Source material for the brand and the document templates. Useful to keep on
# hand, not needed to build or run the application.
/files
/public/brand/mersam-logo-full.jpg

# Editor and operating system noise
.vscode
.idea
.DS_Store
Thumbs.db
*.log
npm-debug.log*
